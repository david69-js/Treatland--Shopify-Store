{%- comment -%}
	------------------------------------------------------------------------------
	Section: Image with text(animations)
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/image-with-text-animations.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign description_color          = section.settings.description_color -%}
{%- assign container_color           = section.settings.container_color -%}

{%- assign marquee_text_duplicate    = section.settings.duplicate_marquee_text | plus: 1 -%}
{%- assign space_between_items        = section.settings.space_between_items | append: 'px' -%}

{%- assign marquee_speed            = section.settings.marquee_speed | default: 10 -%}
{%- assign marquee_enable           = section.settings.enable_marquee_text -%}

{%- assign is_lazy 					 = false -%}

{%- if section.index > 1 -%}
	{%- assign is_lazy = true -%}
{%- endif -%}

{%- capture styles -%}
    --container-color: {{ container_color }}; {{-  -}}
	--description-color: {{- description_color -}}; {{-  -}}
    --gap: {{- space_between_items -}}
{%- endcapture -%}


{%- if marquee_enable -%}
    <style>
    .marquee__track {
        animation: scroll {{ marquee_speed }}s linear infinite !important;
        will-change: transform;
        flex-wrap: nowrap;
    }        
    </style>
{%- endif -%}

{%- if is_lazy -%}
{% style %}
    .marquee--text {
        opacity: 0;
    }
    .marquee--text.animated {
        opacity: 1;
        transition: opacity 0.5s ease-in-out;
    }   
{% endstyle %}
{%- endif -%}

<section
	class="marquee--text {% if section.index > 1 %}image-with-text-animations--delay{% endif %} {% if request.visual_preview_mode or section.index == 1 %} animated{% endif %} js-animate"
	style="{{- styles -}}"
>
	<div class="marquee__container">
		<div class="marquee__track">
			{% assign total_items = marquee_text_duplicate %}
			{% assign repeat_count = total_items | times: total_items | ceil %}

			{% for i in (1..repeat_count) %}
				{% for block in section.blocks %}
					<div class="marquee__slide">
						{{ block.settings.description }}
					</div>
				{% endfor %}
			{% endfor %}
		</div>
	</div>

</section>


{%- schema -%}
{
	"name": "Marquee Text",
	"settings": [
        {
			"type": "number",
			"id": "duplicate_marquee_text",
			"label": "Duplicate Marquee Text",
			"info": "Number of times to duplicate text"
		},
        {
            "type": "number",
            "id": "space_between_items",
            "label": "Space between Items",
            "default": 100
        },
        {
            "type": "number",
            "id": "marquee_speed",
            "label": "Marque Speed",
            "default": 90
        },
        {
			"type": "checkbox",
			"id": "enable_marquee_text",
			"label": "Enable Marquee Text",
			"default": false
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "container_color",
			"label": "Container Background Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "description_color",
			"label": "Description Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text Color",
			"default": "#535353"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop Offset Top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop Offset Bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile Offset Top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile Offset Bottom",
			"default": 25
		}
	],
    "blocks": [
        {
            "type": "text",
            "name": "Marquee Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                }
            ]
        }
    ],
	"presets": [
		{
			"name": "Marquee Text",
			"settings": {}
		}
	]
}
{%- endschema -%}



