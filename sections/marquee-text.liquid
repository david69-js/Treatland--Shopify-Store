{%- comment -%}
	------------------------------------------------------------------------------
	Section: Image with text(animations)
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/image-with-text-animations.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign description_color          = section.settings.description_color -%}
{%- assign text_color 		         = section.settings.text_color -%}
{%- assign container                 = section.settings.container_width -%}
{%- assign container_color           = section.settings.container_color -%}
{%- assign text_align                 = section.settings.text_align -%}

{%- assign enable_marque              = section.settings.enable_marque -%}

{%- assign is_lazy 					 = false -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- if section.index > 1 -%}
	{%- assign is_lazy = true -%}
{%- endif -%}

{%- capture styles -%}
	--container-width: {{ container_width }}; {{-  -}}
    --container-color: {{ container_color }}; {{-  -}}
	--description-color: {{- description_color -}}; {{-  -}}
	--text-color: {{- text_color -}};
    --text-align: {{- text_align -}};
{%- endcapture -%}

<section
	class="image-with-text-animations {% if section.index > 1 %}image-with-text-animations--delay{% endif %} {% if request.visual_preview_mode or section.index == 1 %} animated{% endif %} js-animate"
	style="{{- styles -}}"
>

	{%- if description != blank -%}
		<div class="image-with-text-animations__content">
			{%- if description != blank -%}
				<div class="image-with-text-animations__description">
					{{- description -}}
				</div>
			{%- endif -%}
		</div>

        <div class="marquee__container">
            <div class="marquee__track">
              {% assign total_items = section.blocks.size %}
              {% assign repeat_count = total_items | times: total_items | ceil %}
  
              {% for i in (1..repeat_count) %}
                {% for block in section.blocks %}
                  <div class="marquee__slide">
                    {% if block.settings.logo != blank %}
                      {% assign logo_max_size = block.settings.logo.width | divided_by: 2 | at_most: 200 %}
                      {% capture logo_style %}width: {{ logo_max_size }}px{% endcapture %}
                      {{ block.settings.logo | image_url: width: block.settings.logo.width | image_tag: loading: 'lazy', style: logo_style, class: 'slide-image' }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'slide slide--placeholder' }}
                    {% endif %}
                  </div>
                {% endfor %}
              {% endfor %}
            </div>
          </div>
	{%- endif -%}
</section>

{%- schema -%}
{
	"name": "Marquee Text",
	"settings": [
        {
			"type": "number",
			"id": "duplicate_marquee_text",
			"label": "Duplicate Marquee Text",
			"info": "Number of times to duplicate text"
		},
        {
			"type": "checkbox",
			"id": "enable_marquee_text",
			"label": "Enable Marquee Text",
			"default": false
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "container_color",
			"label": "Container Background Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "description_color",
			"label": "Description Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text Color",
			"default": "#535353"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container Width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full Width"
				},
				{
					"value": "inherit",
					"label": "Inherit from General Settings"
				}
			],
			"default": "inherit",
			"info": "If you select 'Inherit from General Settings', then the container width will be used from the Theme settings/Layout."
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop Offset Top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop Offset Bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile Offset Top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile Offset Bottom",
			"default": 25
		}
	],
    "blocks": [
        {
            "type": "text",
            "name": "Marquee Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description"
                }
            ]
        }
    ],
	"presets": [
		{
			"name": "Marquee Text",
			"settings": {}
		}
	]
}
{%- endschema -%}



