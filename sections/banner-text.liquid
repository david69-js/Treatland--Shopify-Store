{%- comment -%}
	------------------------------------------------------------------------------
	Section: Image with text(animations)
	------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/image-with-text-animations.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign heading                   = section.settings.heading -%}
{%- assign heading_font_size_desktop = section.settings.heading_font_size_desktop | append: "px" -%}
{%- assign description                = section.settings.description -%}
{%- assign heading_color             = section.settings.heading_color -%}
{%- assign heading_outline           = section.settings.heading_outline -%}
{%- assign heading_background        = section.settings.heading_background -%}
{%- assign description_color          = section.settings.description_color -%}
{%- assign text_color 		         = section.settings.text_color -%}
{%- assign container                 = section.settings.container_width -%}
{%- assign container_color           = section.settings.container_color -%}
{%- assign text_align                 = section.settings.text_align -%}

{%- assign is_lazy 					 = false -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- if section.index > 1 -%}
	{%- assign is_lazy = true -%}
{%- endif -%}

{%- capture styles -%}
	--container-width: {{ container_width }}; {{-  -}}
    --container-color: {{ container_color }}; {{-  -}}
	--heading-desktop-font-size: {{- heading_font_size_desktop -}}; {{-  -}}
	--heading-color: {{- heading_color -}}; {{-  -}}
	--heading-outline: {{- heading_outline -}}; {{-  -}}
	--heading-background: {{- heading_background -}}; {{-  -}}
	--description-color: {{- description_color -}}; {{-  -}}
	--text-color: {{- text_color -}};
    --text-align: {{- text_align -}};
{%- endcapture -%}

<section
	class="image-with-text-animations {% if section.index > 1 %}image-with-text-animations--delay{% endif %} {% if request.visual_preview_mode or section.index == 1 %} animated{% endif %}{% if heading != blank and image != blank %} js-image-with-text-animations{% endif %} js-animate"
	style="{{- styles -}}"
>
	<div class="image-with-text-animations--container">
		{%- if heading != blank -%}
			<div class="image-with-text-animations__main">
				{%- if heading != blank -%}
					<div class="image-with-text-animations__heading-wrapper">
						<h2 class="image-with-text-animations__heading">
							{{- heading -}}
						</h2>
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}
	
		{%- if description != blank -%}
			<div class="image-with-text-animations__content">
				{%- if description != blank -%}
					<div class="image-with-text-animations__description">
						{{- description -}}
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}
	</div>
</section>

{%- schema -%}
{
	"name": "Banner Heading & Text",
	"settings": [
		{
			"type": "textarea",
			"id": "heading",
			"label": "Heading",
			"default": "Heading"
		},
		{
			"type": "range",
			"id": "heading_font_size_desktop",
			"min": 1,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Heading desktop font size",
			"default": 100
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "description",
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "container_color",
			"label": "Container Background Color",
			"default": "#000"
		},
        {
			"type": "color",
			"id": "heading_color",
			"label": "Heading",
			"default": "#000"
		},
		{
			"type": "color",
			"id": "heading_outline",
			"label": "Heading outline",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "heading_background",
			"label": "Heading background"
		},
		{
			"type": "color",
			"id": "description_color",
			"label": "description",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#535353"
		},
		{
			"type": "header",
			"content": "Layout"
		},
        {
			"type": "select",
			"id": "text_align",
			"label": "Text align",
			"options": [
				{
					"value": "center",
					"label": "Center",
				},
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "right",
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"presets": [
		{
			"name": "Banner Heading & Text",
			"settings": {}
		}
	]
}
{%- endschema -%}

