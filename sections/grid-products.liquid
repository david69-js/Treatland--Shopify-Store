{%- comment -%}
------------------------------------------------------------------------------
	Section: Grid Products
------------------------------------------------------------------------------
{%- endcomment -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
	#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign container 			= section.settings.container_width -%}
{%- assign blocks 				= section.blocks  -%}
{%- assign has_filled_block 	= true -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{% assign container_width = container %}
{%- endif -%}

{%- assign image_size        = 640 -%}
{%- assign image_size_tablet = 382 -%}
{%- assign image_size_mobile = 240 -%}

{%- assign heading 					= section.settings.heading -%}

{%- capture style -%}
	--container-width: {{ container_width -}};
{%- endcapture -%}

{%- assign heading = section.settings.heading -%}
{%- assign products_in_row = section.settings.products_in_row -%}
{%- assign product_list = section.settings.product_list -%}
{%- assign container = section.settings.container_width -%}
{%- assign banner_image = section.settings.banner_image -%}
{%- assign banner_heading = section.settings.banner_heading -%}
{%- assign banner_subheading = section.settings.banner_subheading -%}
{%- assign button_labelB = section.settings.button_labelB -%}
{%- assign button_url = section.settings.button_url -%}
{%- assign text_color = section.settings.text_color -%}
{%- assign button_color = section.settings.button_color -%}
{%- assign button_background_color = section.settings.button_background_color -%}
{%- assign button_border_color = section.settings.button_border_color -%}
{%- assign button_hover_color = section.settings.button_hover_color -%}
{%- assign button_hover_background = section.settings.button_hover_background -%}
{%- assign button_hover_border = section.settings.button_hover_border -%}
{%- assign overlay_color = section.settings.overlay_color -%}


{% assign is_button = false %}

{% if button_labelB != blank and button_url != blank %}
	{% assign is_button = true %}
{% endif %}

{% assign is_banner = false %}

{% if banner_image != blank %}
	{% assign is_banner = true %}
{% endif %}

{% assign cardType = section.settings.card_style %}

{% capture section_styles %}
	--container-width: {{ container_width }};
	--text-color: {{ text_color }};
	--button-color: {{ button_color }};
	--button-background-color: {{ button_background_color }};
	--button-border-color: {{ button_border_color }};
	--button-hover-color: {{ button_hover_color }};
	--button-hover-background: {{ button_hover_background }};
	--button-hover-border: {{ button_hover_border }};
	--overlay-color: {{ overlay_color }};
{% endcapture %}

{%- if has_filled_block -%}
	<section class="section--{{ section.id }} products-thumbnails products-thumbnails--variant js-products-thumbnails-section js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
			 style="{{- style -}}"
	>
		{%- render 'adastra' with '/src/styles/products-thumbnails.scss' -%}

		<div class="products-thumbnails__container">
			<div class="products-thumbnails__heading-wrapper">
				{%- if heading != blank -%}
					<h2 class="product-tabs__title need-animate tr-dur-0-5">{{- heading -}}</h2>
				{%- endif -%}

				{%- assign product_list = section.settings.product_list -%}
				{%- assign button_label = section.settings.button_label -%}
				{%- assign button_link = section.settings.button_link -%}

				
				<div class="products-thumbnails__tab js-products-thumbnails-tab products-thumbanails__tab--position--{{ section.settings.banner_grid_position }}" data-index="{{- index -}}" style="{{ section_styles }}" >
							
				{% if is_banner %}
					<div class="featured-products__content-wrapper {% if is_banner and product_list.count > 0 %}flex-50{% endif %}">
							<div class="featured-products__banner featured-products__banner--variant need-animate tr-dur-0-75 ">
								{% if products_in_row == "5" %}
									{% assign w_1920 = "361x479" %}
									{% assign w_1920_2x = "722x958" %}

									{% assign w_1600 = "300x427" %}
									{% assign w_1600_2x = "600x854" %}
								{% elsif products_in_row == "4" %}
									{% assign w_1920 = "361x536" %}
									{% assign w_1920_2x = "722x1072" %}

									{% assign w_1600 = "300x472" %}
									{% assign w_1600_2x = "600x944" %}
								{% else %}
									{% assign w_1920 = "361x664" %}
									{% assign w_1920_2x = "722x1328" %}

									{% assign w_1600 = "300x577" %}
									{% assign w_1600_2x = "600x1154" %}
								{% endif %}

								{% if banner_image != blank %}
									<picture {% if section.index != 1 %}class="lazy"{% endif %}>
										{% if section.index != 1 %}
											<source
												data-srcset="{{ banner_image | img_url: "343x359", crop: "center" }} 1x, {{ banner_image | img_url: "686x718", crop: "center" }} 2x"
												srcset="{{ banner_image | img_url: "10x" }} 1x, {{ banner_image | img_url: "20x" }} 2x"
												media="(max-width: 375px)"
											/>

											<source
												data-srcset="{{ banner_image | img_url: "735x359", crop: "center" }} 1x, {{ banner_image | img_url: "1470x718", crop: "center" }} 2x"
												srcset="{{ banner_image | img_url: "10x" }} 1x, {{ banner_image | img_url: "20x" }} 2x"
												media="(max-width: 767px)"
											/>

											<source
												data-srcset="{{ banner_image | img_url: "268x486", crop: "center" }} 1x, {{ banner_image | img_url: "536x972", crop: "center" }} 2x"
												srcset="{{ banner_image | img_url: "10x" }} 1x, {{ banner_image | img_url: "20x" }} 2x"
												media="(max-width: 991px)"
											/>

											<source
												data-srcset="{{ banner_image | img_url: "268x474", crop: "center" }} 1x, {{ banner_image | img_url: "536x948", crop: "center" }} 2x"
												srcset="{{ banner_image | img_url: "10x" }} 1x, {{ banner_image | img_url: "20x" }} 2x"
												media="(max-width: 1200px)"
											/>

											<source
												data-srcset="{{ banner_image | img_url: w_1600, crop: "center" }} 1x, {{ banner_image | img_url: w_1600_2x, crop: "center" }} 2x"
												srcset="{{ banner_image | img_url: "10x" }} 1x, {{ banner_image | img_url: "20x" }} 2x"
												media="(max-width: 1600px)"
											/>

											<img class="featured-products__banner-image"
												srcset="{{- banner_image | img_url: '10x' -}} 1x, {{ banner_image | img_url: '20x' }} 2x"
												src="{{ banner_image | img_url: w_1920 }}"
												data-src="{{- banner_image | img_url: w_1920, crop: "center" -}}"
												data-srcset="{{ banner_image | img_url: w_1920, crop: "center" }} 1x, {{ banner_image | img_url: w_1920_2x, crop: "center" }} 2x"
												style="object-fit: {{ section.settings.banner_fit }}; object-position: {{ section.settings.banner_position }};"
												alt="{{ banner_image.alt | escape }}">
										{% else %}
											<source
												srcset="{{ banner_image | img_url: "343x359", crop: "center" }} 1x, {{ banner_image | img_url: "686x718", crop: "center" }} 2x"
												media="(max-width: 375px)"
											/>

											<source
												srcset="{{ banner_image | img_url: "735x359", crop: "center" }} 1x, {{ banner_image | img_url: "1470x718", crop: "center" }} 2x"
												media="(max-width: 767px)"
											/>

											<source
												srcset="{{ banner_image | img_url: "268x486", crop: "center" }} 1x, {{ banner_image | img_url: "536x972", crop: "center" }} 2x"
												media="(max-width: 991px)"
											/>

											<source
												srcset="{{ banner_image | img_url: "268x474", crop: "center" }} 1x, {{ banner_image | img_url: "536x948", crop: "center" }} 2x"
												media="(max-width: 1200px)"
											/>

											<source
												srcset="{{ banner_image | img_url: w_1600, crop: "center" }} 1x, {{ banner_image | img_url: w_1600_2x, crop: "center" }} 2x"
												media="(max-width: 1600px)"
											/>

											<img class="featured-products__banner-image"
												src="{{- banner_image | img_url: w_1920, crop: "center" -}}"
												srcset="{{ banner_image | img_url: w_1920, crop: "center" }} 1x, {{ banner_image | img_url: w_1920_2x, crop: "center" }} 2x"
												style="{{ focal_point }}"
												fetchpriority="high"
												alt="{{ banner_image.alt | escape }}">
										{% endif %}
									</picture>
								{% else %}
									{{ "detailed-apparel-1" | placeholder_svg_tag: "featured-products__banner-image" }}
								{% endif %}

								<div class="featured-products__banner-content featured-products__banner-content--variant" style="justify-content: {{ section.settings.banner_content_position }}">
									{% if banner_heading != blank %}
										<h3 class="featured-products__banner-heading need-animate tr-dur-0-5 tr-del-0-25">{{ banner_heading }}</h3>
									{% endif %}

									{% if banner_subheading != blank %}
										<p class="featured-products__banner-subheading need-animate tr-dur-0-5 tr-del-0-5">{{ banner_subheading }}</p>
									{% endif %}

									{%- if is_button -%}
										<div class="featured-products__button-wrapper need-animate tr-dur-0-5 tr-del-0-75">
											<a class="featured-products__button button button--primary-border"
											href="{{- button_url -}}">
												{{- button_label -}}
											</a>
										</div>
									{%- endif -%}
								</div>
							</div>

					</div>
					{% style %}
					.section--{{ section.id }} .featured-products__banner-heading{
						font-size: {{ section.settings.heading_fontsize }}px;
					}
					.section--{{ section.id }} .featured-products__banner-subheading{
						font-size: {{ section.settings.subheading_fontsize }}px;
					}
					@media (max-width: 1024px) {
						.section--{{ section.id }} .featured-products__banner-heading{
							font-size: {{ section.settings.heading_fontsize_mobile }}px;
						}
						.section--{{ section.id }} .featured-products__banner-subheading{
							font-size: {{ section.settings.subheading_fontsize_mobile }}px;
						}
					}
					
		    		{% endstyle %}
				{% endif %}

					<div class="products-thumbnails__tab-content products-thumbnails__tab-content--grid {% if is_banner and product_list.count > 0 %}flex-50 {% else %}flex-100 {% endif %}">
						{%- if product_list.count > 0 -%}
							{% if forloop.index == 1 %}
								{% assign delay_card_step = 0.25 %}
							{% endif %}

							{%- for product in product_list limit: limit -%}
								{% assign delay_card_step = delay_card_step | plus: 0.25 %}
								<div class="products-thumbnails__product products-thumbnails__product--variant-card  products-thumbnails__product--{{ section.settings.items_per_row }}"
									{% if forloop.parentloop.index == 1 %}style="--card-delay: {{ delay_card_step | append: 's' }};"{% endif %}
								>
									{%- render
										'product-card-form-variant',
										product: product,
										size: image_size,
										tablet_size: image_size_tablet,
										mobile_size: image_size_mobile,
										cardType: cardType
									-%}
								</div>
							{%- endfor -%}
						{%- else -%}
							{%- for i in (1..4) -%}
								<div class="products-thumbnails__product products-thumbnails__product--variant-card products-thumbnails__product--{{ section.settings.items_per_row }}" ">
									{%- render 'product-card', product: nil -%}
								</div>
							{%- endfor -%}
						{%- endif -%}
					</div>

					{% if button_link != blank and button_label != blank %}
						<div class="products-thumbnails__button-wrapper need-animate tr-dur-0-5 tr-del-1-5">
							<a class="products-thumbnails__button button button--secondary-border"
							href="{{ button_link }}">{{ button_label }}</a>
						</div>
					{% endif %}
				</div>
		</div>

	
		</div>

		<script src="{{ 'add-to-cart-grid.js' | asset_url }}" type="module" crossorigin="anonymous"></script>
	</section>
{%- endif -%}


{%- schema -%}
{
	"name": "Grid Products",
	"disabled_on": {
		"groups": [
			"header",
			"footer"
		]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Grid Products"
		},
		{
			"type": "header",
			"content": "Banner Image"
		},
		{
			"type": "image_picker",
			"id": "banner_image",
			"label": "Image"
		},
		{
			"type": "select",
			"id": "banner_fit",
			"label": "Banner Image Fit",
			"options": [
			{
				"value": "contain",
				"label": "Contain"
			},
			{
				"value": "cover",
				"label": "Cover"
			},
			{
				"value": "fill",
				"label": "Fill"
			},
			{
				"value": "none",
				"label": "None"
			}
		],
			"default": "cover"
		},
		{
			"type": "select",
			"id": "banner_position",
			"label": "Banner Image Position",
			"options": [
			{
				"value": "center",
				"label": "Center"
			},
			{
				"value": "right",
				"label": "Right"
			},
			{
				"value": "bottom",
				"label": "Bottom"
			},
			{
				"value": "left",
				"label": "Left"
			},
			{
				"value": "top",
				"label": "Top"
			}
		],
			"default": "center"
		},
		{
			"type": "text",
			"id": "banner_heading",
			"label": "Heading",
			"default": "Banner heading"
		},
		{
			"type": "range",
			"id": "heading_fontsize",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop font size",
			"default": 40
		},
			{
			"type": "range",
			"id": "heading_fontsize_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile font size",
			"default": 40
		},
		{
			"type": "text",
			"id": "banner_subheading",
			"label": "Subheading",
			"default": "Banner subheading"
		},
			{
			"type": "range",
			"id": "subheading_fontsize",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop font size",
			"default": 40
		},
		{
			"type": "range",
			"id": "subheading_fontsize_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile font size",
			"default": 40
		},
		{
			"type": "text",
			"id": "button_labelB",
			"label": "Button label",
			"default": "Shop Now"
		},
		{
			"type": "url",
			"id": "button_url",
			"label": "Button link"
		},
		{
			"type": "select",
			"id": "banner_content_position",
			"label": "Banner Justify Content",
			"options": [
			{
				"value": "center",
				"label": "Center"
			},
			{
				"value": "flex-end",
				"label": "End"
			},
			{
				"value": "flex-start",
				"label": "Start"
			}
		],
			"default": "center"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text color",
			"default": "#fff"
		},
		{
			"type": "color_background",
			"id": "overlay_color",
			"label": "Overlay color",
			"default": "rgba(0, 0, 0, 0.4)"
		},
		{
			"type": "color",
			"id": "button_color",
			"label": "Button color",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "button_background_color",
			"label": "Button background",
			"default": "transparent"
		},
		{
			"type": "color",
			"id": "button_border_color",
			"label": "Button border",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "button_hover_color",
			"label": "Button color (hover)",
			"default": "#000"
		},
		{
			"type": "color",
			"id": "button_hover_background",
			"label": "Button background (hover)",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "button_hover_border",
			"label": "Button border (hover)",
			"default": "#fff"
		},
		{
			"type": "header",
			"content": "Card Settings"
		},
		{
			"type": "select",
			"id": "card_style",
			"label": "Card Style",
			"options": [
			{
				"value": "horizontal_card_style",
				"label": "Horizontal Card"
			},
			{
				"value": "vertical_card_style",
				"label": "Vertical Card"
			},
			{
				"value": "full_card_style",
				"label": "Full Card"
			}
		],
			"default": "horizontal_card_style",
		},
		{
			"type": "checkbox",
			"id": "show_desciption_card",
			"label": "Show description Card",
			"default": true
		},
		{
			"type": "number",
			"id": "truncate_description_card",
			"label": "Cut the description from the card",
			"default": 70
		},
		{
			"type": "checkbox",
			"id": "truncate_description_card_enable",
			"label": "Enable description cut",
			"default": true
		},
        {
            "type": "product_list",
            "id": "product_list",
            "label": "Products"
        },
		{
            "type": "text",
            "id": "badgesale",
            "label": "Sale: Text",
            "default": "Sale"
        },
		{
            "type": "text",
            "id": "badgesale_description",
            "label": "Sale description: Text",
            "default": "Sale"
        },
		{
            "type": "text",
            "id": "badgeherenow",
            "label": "Here Now: Here Now",
            "default": "Here Now"
        },
		{
            "type": "text",
            "id": "badgeherenow_description",
            "label": "Here Now description: Is here now",
            "default": "Is here now"
        },
		{
            "type": "text",
            "id": "badgesoldout",
            "label": "Sold out: Sold Out",
            "default": "Sold out"
        },
		{
            "type": "text",
            "id": "badgesoldout_description",
            "label": "Sold out description: Sold Out",
            "default": "Sold out"
        },
		{
			"type": "header",
			"content": "Layout"
		},
        {
            "type": "text",
            "id": "button_label",
            "label": "Button label",
            "default": "See all products"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
        },
		{
			"type": "select",
			"id": "banner_grid_position",
			"label": "Banner Image & Grid Position",
			"options": [
			{
				"value": "banner_left__grid_right",
				"label": "Banner Left - Grid Right"
			},
			{
				"value": "banner_right__grid_left",
				"label": "Banner Right - Grid Left"
			}
		],
			"default": "banner_left__grid_right"
		},
        {
            "type": "select",
            "id": "items_per_row",
            "label": "Items per row",
            "options": [
                {
                    "value": "grid-1",
                    "label": "1 per row"
                },
                {
                    "value": "grid-2",
                    "label": "2 per row"
                },
                {
                    "value": "grid-3",
                    "label": "3 per row"
                },
                {
                    "value": "grid-4    ",
                    "label": "4 per row"
                }
        ],
        	"default": "grid-2"
        },
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"presets": [
		{
			"name": "Grid Products"
		}
	]
}
{%- endschema -%}
